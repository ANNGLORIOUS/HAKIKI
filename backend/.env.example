# Any long random string, used to hash payment numbers for matching
HMAC_SECRET=change-me-too
# Reports needed (independent, with supported evidence) for "Reported by multiple users"
REPORT_THRESHOLD=3
# S3-compatible storage (leave USE_S3=False to store files locally in /media)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# Run Celery tasks inline (no Redis needed) while developing
CELERY_EAGER=True
# Codes print to the terminal until you configure real providers
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMS_BACKEND=console
# For real SMS via Africa's Talking: SMS_BACKEND=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
